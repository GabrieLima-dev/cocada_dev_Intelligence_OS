{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cocada.dev/schemas/experiment.schema.json",
  "title": "Editorial experiment",
  "x-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "hypothesis", "variable", "control", "primary_metric", "secondary_metrics", "content_ids", "status", "created_at", "result", "conclusion"],
  "properties": {
    "id": {"type": "string", "pattern": "^EXP-[0-9]{4}-[0-9]{4}$"},
    "hypothesis": {"type": "string", "minLength": 1},
    "variable": {"type": "string", "minLength": 1},
    "control": {"type": "string", "minLength": 1},
    "primary_metric": {"type": "string", "minLength": 1},
    "secondary_metrics": {"type": "array", "items": {"type": "string"}},
    "content_ids": {"type": "array", "items": {"type": "string", "pattern": "^CNT-[0-9]{4}-[0-9]{4}$"}},
    "comparison_requirements": {"type": "array", "items": {"type": "string"}},
    "stopping_rule": {"type": "string"},
    "status": {"enum": ["planned", "active", "completed", "cancelled"]},
    "created_at": {"type": "string", "format": "date-time"},
    "result": {"oneOf": [{"type": "object"}, {"const": "UNKNOWN"}]},
    "conclusion": {"enum": ["UNKNOWN", "inconclusive", "supports", "refutes"]},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
